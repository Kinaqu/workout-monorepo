# Clerk publishable key (public — embedded in the app bundle). Same Clerk
# instance as the web frontend's VITE_CLERK_PUBLISHABLE_KEY.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key

# Backend base URL. On a physical device, localhost won't reach `wrangler dev`
# — use your machine's LAN IP, or the hosted Worker below.
EXPO_PUBLIC_API_BASE_URL=https://workout-api.dimer133745.workers.dev
