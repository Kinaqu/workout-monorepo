{
  "name": "workout-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run typecheck",
    "generate:api": "openapi-typescript ../backend/openapi.json -o lib/api/types.gen.ts",
    "generate:api:check": "npm run generate:api && git diff --exit-code -- lib/api/types.gen.ts",
    "check": "npm run generate:api:check && npm run lint && npm run build",
    "test:smoke": "playwright test",
    "test:smoke:local": "npm run build && playwright test"
  },
  "dependencies": {
    "@clerk/react": "latest",
    "boneyard-js": "^1.7.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.19.15",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.2.0"
  }
}
